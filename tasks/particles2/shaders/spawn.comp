#version 450
layout(local_size_x = 64) in;

struct Particle {
    vec4 pos;
    vec4 vel;
    float lifetime;
    float age;
    float pad0;
    float pad1;
};

layout(std430, binding = 1) writeonly buffer OutParticles {
    Particle outParticles[];
};

layout(std430, binding = 3) buffer OutCounter {
    uint outAliveCount;
};

layout(push_constant) uniform SpawnParams {
    vec4 emitterPos;
    uint spawnCount;
    float life;
} spawn;

uint rand(uint seed) {
    seed ^= seed << 13;
    seed ^= seed >> 17;
    seed ^= seed << 5;
    return seed;
}

const uint maxParticles = 1000;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= spawn.spawnCount) return;

    Particle p;
    uint seed = gid * 747796405u + 2891336453u;
    float rand01 = float(rand(seed) & 0xFFFFu) / 65535.0;

    p.pos = spawn.emitterPos + vec4(
        (rand01 - 0.5) * 0.2,   // трохи розкидати по X
        (rand01 - 0.5) * 0.2,    // трохи по Y
        0.0,
        0.0
    ) * 25.0;

    p.vel.xyz = normalize(vec3(
        (float(rand(seed+1) & 0xFFFFu) / 65535.0 - 0.5),
        1.0,
        (float(rand(seed+2) & 0xFFFFu) / 65535.0 - 0.5)
    )) * 2.0;   // швидкість від 2.0 вгору в рандомному напрямку
    p.lifetime = spawn.life;
    p.age = 0;

    uint idx;
    do {
        idx = outAliveCount;
        if (idx >= maxParticles) return;
    } while (atomicCompSwap(outAliveCount, idx, idx + 1) != idx);

    // Тільки тепер можна писати
    outParticles[idx] = p;
}
