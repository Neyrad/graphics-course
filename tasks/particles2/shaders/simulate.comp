#version 450
layout(local_size_x = 256) in;

struct Particle {
    vec3 pos;
    vec3 vel;
    float lifetime;
    float age;
};

layout(std430, binding = 0) readonly buffer InParticles {
    Particle inParticles[];
};

layout(std430, binding = 1) writeonly buffer OutParticles {
    Particle outParticles[];
};

layout(std430, binding = 2) buffer Counter {
    uint aliveCount;
};

layout(push_constant) uniform SimParams {
    float dt;
} sim;

void main() {
    uint i = gl_GlobalInvocationID.x;
    Particle p = inParticles[i];

    // update
    p.age += sim.dt;
    if (p.age > p.lifetime) return;

    p.pos += p.vel * sim.dt;

    // write alive
    uint idx = atomicAdd(aliveCount, 1);
    outParticles[idx] = p;
}
